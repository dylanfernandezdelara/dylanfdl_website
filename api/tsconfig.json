{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../lib/spotify/**/*.ts",
    "../lib/nowPlaying/**/*.ts",
    "../lib/extractErrorMessage.ts",
    "../lib/sanitizedInfrastructureError.ts"
  ]
}
