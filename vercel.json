{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "devCommand": "astro dev --port $PORT --host 127.0.0.1",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "dylanfdl.dev" }],
      "destination": "https://dylanfdl.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.dylanfdl.dev" }],
      "destination": "https://dylanfdl.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/about",
      "statusCode": 307
    }
  ]
}
