#!/usr/bin/env bash
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Install with: brew install gitleaks"
  exit 1
fi

zero="0000000000000000000000000000000000000000"
default_branch_ref="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
default_branch="${default_branch_ref#refs/remotes/origin/}"
if [ -z "${default_branch:-}" ]; then
  default_branch="main"
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base "$local_sha" "origin/$default_branch" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      range="$base..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  echo "Running gitleaks on commits in range: $range"
  gitleaks git . --log-opts="$range" --no-banner --redact
done
