---
import {
  DEFAULT_DESCRIPTION,
  EMPLOYER_NAME,
  EMPLOYER_URL,
  OG_IMAGE_ALT,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_URL,
  OG_IMAGE_WIDTH,
  PERSON_FAMILY_NAME,
  PERSON_GIVEN_NAME,
  PERSON_NAME,
  PERSON_NAME_ALTERNATES,
  PERSON_ROLE,
  PERSON_URL,
  REL_ME_URLS,
  SAME_AS,
  SITE_URL,
  TWITTER_CREATOR,
  absoluteUrl,
  buildPageTitle,
  serializeJsonLd,
  toIsoDateTime,
} from '@/lib/site'

import '@/src/styles/theme.css'
import '@/src/styles/globals.css'
import '@/src/styles/article.css'
import '@/src/styles/effects.css'

interface Props {
  title?: string
  description?: string
  canonicalPath?: string
  profilePage?: boolean
  errorPage?: boolean
  ogType?: 'website' | 'article'
  articlePublishedTime?: string
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonicalPath,
  profilePage = false,
  errorPage = false,
  ogType = 'website',
  articlePublishedTime,
} = Astro.props

const resolvedCanonicalPath = canonicalPath ?? Astro.url.pathname
const canonicalUrl = absoluteUrl(resolvedCanonicalPath)
const personId = `${SITE_URL}/#person`
const publisherId = `${SITE_URL}/#publisher`

const pageTitle = buildPageTitle({ title, profilePage })
const articlePublishedIso = articlePublishedTime ? toIsoDateTime(articlePublishedTime) : undefined

const emitFullHeadMetadata = !errorPage

const personJsonLd = {
  '@type': 'Person',
  '@id': personId,
  name: PERSON_NAME,
  givenName: PERSON_GIVEN_NAME,
  familyName: PERSON_FAMILY_NAME,
  alternateName: [...PERSON_NAME_ALTERNATES],
  url: PERSON_URL,
  sameAs: [...SAME_AS],
  jobTitle: PERSON_ROLE,
  worksFor: {
    '@type': 'Organization',
    name: EMPLOYER_NAME,
    url: EMPLOYER_URL,
  },
}

const publisherJsonLd = {
  '@type': 'Organization',
  '@id': publisherId,
  name: PERSON_NAME,
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: OG_IMAGE_URL,
  },
}

const websiteJsonLd = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: PERSON_NAME,
  alternateName: [...PERSON_NAME_ALTERNATES],
  url: SITE_URL,
  publisher: { '@id': publisherId },
}

const profilePageJsonLd = profilePage
  ? {
      '@type': 'ProfilePage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: PERSON_NAME,
      description,
      mainEntity: { '@id': personId },
      isPartOf: { '@id': `${SITE_URL}/#website` },
    }
  : null

const articleJsonLd =
  ogType === 'article' && title && articlePublishedIso
    ? {
        '@type': 'Article',
        headline: title,
        description,
        datePublished: articlePublishedIso,
        author: { '@id': personId },
        publisher: { '@id': publisherId },
        mainEntityOfPage: canonicalUrl,
        isPartOf: { '@id': `${SITE_URL}/#website` },
      }
    : null

const graph = errorPage
  ? null
  : [websiteJsonLd, publisherJsonLd, personJsonLd, profilePageJsonLd, articleJsonLd].filter(Boolean)

const jsonLd = graph
  ? {
      '@context': 'https://schema.org',
      '@graph': graph,
    }
  : null
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />
    <meta name="description" content={description} />
    {errorPage && <meta name="robots" content="noindex, nofollow" />}
    {emitFullHeadMetadata && (
      <>
        <meta name="author" content={PERSON_NAME} />
        <link rel="canonical" href={canonicalUrl} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {emitFullHeadMetadata && REL_ME_URLS.map((profileUrl) => <link rel="me" href={profileUrl} />)}
    {emitFullHeadMetadata && (
      <>
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={PERSON_NAME} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image" content={OG_IMAGE_URL} />
        <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
        <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
        <meta property="og:image:alt" content={OG_IMAGE_ALT} />
        <meta name="twitter:card" content="summary_large_image" />
        {TWITTER_CREATOR && <meta name="twitter:creator" content={TWITTER_CREATOR} />}
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={OG_IMAGE_URL} />
        <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
        {articlePublishedIso && (
          <meta property="article:published_time" content={articlePublishedIso} />
        )}
      </>
    )}
    <title>{pageTitle}</title>
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme')
          document.documentElement.classList.remove('light', 'dark')
          if (t === 'dark') document.documentElement.classList.add('dark')
          else if (t === 'light') document.documentElement.classList.add('light')
        } catch {
          void 0
        }
      })()
    </script>
  </head>
  <body>
    <main class="pb-safe min-[481px]:pb-safe-8 md:pb-safe-10 md:pt-8">
      <slot />
    </main>
  </body>
</html>
