---
import ThemeToggle from '@/components/ThemeToggle'
import {
  DEFAULT_DESCRIPTION,
  PERSON_FAMILY_NAME,
  PERSON_GIVEN_NAME,
  PERSON_NAME,
  SAME_AS,
  SITE_NAME,
  SITE_URL,
  absoluteUrl,
  buildPageTitle,
} from '@/lib/site'

import '@/src/styles/theme.css'
import '@/src/styles/globals.css'
import '@/src/styles/article.css'
import '@/src/styles/effects.css'

interface Props {
  title?: string
  description?: string
  /** Canonical path (e.g. `/about`). Defaults to the current pathname. */
  path?: string
  /** Use name-first title and ProfilePage structured data (for `/about`). */
  profilePage?: boolean
  ogType?: 'website' | 'article'
  articlePublishedTime?: string
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  path,
  profilePage = false,
  ogType = 'website',
  articlePublishedTime,
} = Astro.props

const canonicalPath = path ?? Astro.url.pathname
const canonicalUrl = absoluteUrl(canonicalPath)
const personId = `${SITE_URL}/#person`

const pageTitle = buildPageTitle({ title, profilePage })

const personJsonLd = {
  '@type': 'Person',
  '@id': personId,
  name: PERSON_NAME,
  givenName: PERSON_GIVEN_NAME,
  familyName: PERSON_FAMILY_NAME,
  alternateName: [SITE_NAME, 'Dylan Fernandez de lara'],
  url: SITE_URL,
  sameAs: [...SAME_AS],
  jobTitle: 'Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Meta',
  },
}

const websiteJsonLd = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: PERSON_NAME,
  alternateName: SITE_NAME,
  url: SITE_URL,
  publisher: { '@id': personId },
}

const profilePageJsonLd = profilePage
  ? {
      '@type': 'ProfilePage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: PERSON_NAME,
      description,
      mainEntity: { '@id': personId },
      isPartOf: { '@id': `${SITE_URL}/#website` },
    }
  : null

const articleJsonLd =
  ogType === 'article' && title && articlePublishedTime
    ? {
        '@type': 'Article',
        headline: title,
        description,
        datePublished: articlePublishedTime,
        author: { '@id': personId },
        publisher: { '@id': personId },
        mainEntityOfPage: canonicalUrl,
        isPartOf: { '@id': `${SITE_URL}/#website` },
      }
    : null

const graph = [websiteJsonLd, personJsonLd, profilePageJsonLd, articleJsonLd].filter(Boolean)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
}
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={PERSON_NAME} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {SAME_AS.map((profileUrl) => <link rel="me" href={profileUrl} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={PERSON_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@dylan_fdl_" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme')
          document.documentElement.classList.remove('light', 'dark')
          if (t === 'dark') document.documentElement.classList.add('dark')
          else if (t === 'light') document.documentElement.classList.add('light')
        } catch {
          /* ignore */
        }
      })()
    </script>
  </head>
  <body>
    <main class="pb-16 min-[481px]:pb-14 md:pb-12 md:pt-8">
      <slot />
    </main>
    <ThemeToggle client:load />
  </body>
</html>
