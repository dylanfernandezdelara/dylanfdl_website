---
import BaseLayout from '@/src/layouts/BaseLayout.astro'
import CardGridClient from '@/components/CardGridClient'
import ExternalLink from '@/components/ExternalLink'
import PageSearchPalette from '@/components/PageSearchPalette'
import OptimistText from '@/components/OptimistText'
// Spotify now-playing — hidden while intro feels crowded; uncomment import + block below to restore
// import CurrentlyListeningText from '@/components/CurrentlyListeningText'
import { buildCardGridItems } from '@/lib/buildCardGridItems'
import { CONTACT_LINKS, DEFAULT_DESCRIPTION } from '@/lib/site'

const cardGridItems = buildCardGridItems()

const CONTACT_LINK_STYLES =
  'text-fg2 no-underline transition-colors duration-150 hover:text-fg1 hover:underline hover:decoration-[color:color-mix(in_oklab,var(--fg2),transparent_35%)] focus-visible:outline-2 focus-visible:outline-blue focus-visible:outline-offset-3'
---

<BaseLayout description={DEFAULT_DESCRIPTION} path="/about" profilePage>
  <div class="mx-auto max-w-4xl px-4 pb-8 pt-14 text-base leading-[1.6] min-[481px]:px-6 min-[481px]:pb-10 min-[481px]:pt-12 md:px-8 md:pb-16 md:pt-16">
    <div>
      <h1 class="sr-only">Dylan Fernandez de Lara</h1>

      <p class="mb-3 text-fg1 min-[481px]:mb-4 md:mb-6">
        I'm Dylan. I am an{'\u00A0'}<OptimistText client:load /></p>

      <p class="mb-3 text-fg1 min-[481px]:mb-4 md:mb-6">
        I am a Yale graduate and an engineer in{' '}
        <ExternalLink
          allowWrap
          href="https://www.reuters.com/technology/meta-transfers-top-engineers-into-new-ai-tooling-team-2026-04-09/"
          >Applied AI</ExternalLink
        > at Meta.
      </p>

      <p class="mb-3 text-fg1 min-[481px]:mb-4 md:mb-6">
        Previously, I scaled crash infrastructure to support a growing number of devices in{' '}
        <ExternalLink
          allowWrap
          href="https://www.meta.com/ai-glasses/meta-ray-ban-display/"
          >Wearables</ExternalLink
        >.
      </p>

      {/* <p class="mb-3 text-fg1 min-[481px]:mb-4 md:mb-6">
        <CurrentlyListeningText client:load />
      </p> */}
    </div>

    <CardGridClient items={cardGridItems} client:load>
      <hr class="mb-3 mt-8 w-full border-0 border-t border-bg3 min-[481px]:mb-4 md:mb-6" />

      <div class="max-w-reading">
        <div class="flex flex-wrap items-baseline gap-2 text-sm text-fg2">
          {
            CONTACT_LINKS.map((link, index) => (
              <>
                {index > 0 && (
                  <span
                    class="select-none text-[color:color-mix(in_oklab,var(--fg2),transparent_35%)]"
                    aria-hidden="true"
                  >
                    ·
                  </span>
                )}
                <a class={CONTACT_LINK_STYLES} href={link.href}>
                  {link.label}
                </a>
              </>
            ))
          }
        </div>
      </div>
    </CardGridClient>
  </div>
  <PageSearchPalette client:load />
</BaseLayout>
