---
import BaseLayout from '@/src/layouts/BaseLayout.astro'
import AboutCardGridWithFooter from '@/components/AboutCardGridWithFooter'
import ExternalLink from '@/components/ExternalLink'
import PageSearchPalette from '@/components/PageSearchPalette'
import RainbowText from '@/components/RainbowText'
import { buildCardGridItems } from '@/lib/buildCardGridItems'

const cardGridItems = buildCardGridItems()

const CONTACT_LINK_STYLES =
  'text-fg2 no-underline transition-colors duration-150 hover:text-fg1 hover:underline hover:decoration-[color:color-mix(in_oklab,var(--fg2),transparent_35%)] focus-visible:outline-2 focus-visible:outline-blue focus-visible:outline-offset-3'
---

<BaseLayout title="About me">
  <div class="mx-auto max-w-4xl px-4 pb-8 pt-14 text-base leading-[1.6] min-[481px]:px-6 min-[481px]:pb-10 min-[481px]:pt-12 md:px-8 md:pb-16 md:pt-16">
    <div class="about-intro-blurb">
      <p class="mb-3 text-fg1 min-[481px]:mb-4 md:mb-6">
        I'm Dylan. I am an{' '}
        <RainbowText text="optimist." />
      </p>

      <p class="mb-3 text-fg1 min-[481px]:mb-4 md:mb-6">
        I am a Yale graduate and an engineer in{' '}
        <ExternalLink
          allowWrap
          href="https://www.reuters.com/technology/meta-transfers-top-engineers-into-new-ai-tooling-team-2026-04-09/"
          >Applied AI</ExternalLink
        > at Meta.
      </p>

      <p class="mb-3 text-fg1 min-[481px]:mb-4 md:mb-6">
        Previously, I scaled infrastructure to support a growing number of devices in{' '}
        <span class="whitespace-nowrap"
          ><ExternalLink href="https://www.meta.com/ai-glasses/meta-ray-ban-display/"
            >Wearables</ExternalLink
          >,</span
        > and built agents to improve stability across our hardware fleet.
      </p>
    </div>

    <AboutCardGridWithFooter items={cardGridItems} client:load>
      <hr class="mb-3 mt-8 border-0 border-t border-bg3 min-[481px]:mb-4 md:mb-6" />

      <div class="flex flex-wrap items-baseline gap-2 text-sm text-fg2">
        <a class={CONTACT_LINK_STYLES} href="https://github.com/dylanfernandezdelara">
          GitHub
        </a>
        <span
          class="select-none text-[color:color-mix(in_oklab,var(--fg2),transparent_35%)]"
          aria-hidden="true"
        >
          ·
        </span>
        <a class={CONTACT_LINK_STYLES} href="mailto:fernandezdelaradylan@gmail.com">
          Email
        </a>
        <span
          class="select-none text-[color:color-mix(in_oklab,var(--fg2),transparent_35%)]"
          aria-hidden="true"
        >
          ·
        </span>
        <a class={CONTACT_LINK_STYLES} href="https://x.com/dylan_fdl_">
          Twitter
        </a>
        <span
          class="select-none text-[color:color-mix(in_oklab,var(--fg2),transparent_35%)]"
          aria-hidden="true"
        >
          ·
        </span>
        <a
          class={CONTACT_LINK_STYLES}
          href="https://www.linkedin.com/in/dylan-fernandez-de-lara-219b821a6"
        >
          LinkedIn
        </a>
      </div>
    </AboutCardGridWithFooter>
  </div>
  <PageSearchPalette client:load />
</BaseLayout>
