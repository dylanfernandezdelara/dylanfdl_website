---
import BaseLayout from '@/src/layouts/BaseLayout.astro'
import { NOT_FOUND_DESCRIPTION } from '@/lib/site'
---

<BaseLayout title="Not found" description={NOT_FOUND_DESCRIPTION} errorPage>
  <div class="mx-auto max-w-reading px-4 pt-12 min-[481px]:px-6 md:px-8">
    <h1 class="mb-4 text-2xl font-bold text-red">404</h1>
    <p class="mb-8 leading-[1.6] text-fg2">Page not found.</p>
    <a href="/about" class="text-sm text-blue">← Back to About</a>
  </div>
</BaseLayout>
